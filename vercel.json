{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/portal-assets/(.*)",
      "dest": "/portal/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/login",
      "dest": "/portal/login.html"
    },
    {
      "src": "/register",
      "dest": "/portal/register.html"
    },
    {
      "src": "/admin",
      "dest": "/portal/admin.html"
    },
    {
      "src": "/teacher",
      "dest": "/portal/teacher.html"
    },
    {
      "src": "/student",
      "dest": "/portal/student.html"
    },
    {
      "src": "/parent",
      "dest": "/portal/parent.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
